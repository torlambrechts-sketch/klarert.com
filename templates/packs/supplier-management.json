    {
      "ref": "check",
      "name": "Supplier requirement checks",
      "description": "One check per supplier and requirement: the status, the evidence and when it expires. Added and flagged by the sync; never deleted. Access follows the supplier register (same folder).",
      "itemLabel": "Check",
      "idPrefix": "SRC-",
      "folder": "suppliers",
      "uniqueLinks": [
        "supplier",
        "requirement"
      ],
      "groups": [
        {
          "ref": "all",
          "name": "Checks",
          "color": "blue"
        }
      ],
      "fields": [
        {
          "key": "supplier",
          "name": "Supplier",
