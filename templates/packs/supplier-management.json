          "config": {
            "options": [
              {
                "id": "opt_pass",
                "label": "Pass",
                "color": "green"
              },
              {
                "id": "opt_conditions",
                "label": "Pass with conditions",
                "color": "orange"
              },
              {
                "id": "opt_fail",
                "label": "Fail",
                "color": "red"
              }
