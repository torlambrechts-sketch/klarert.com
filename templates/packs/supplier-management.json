      "trigger": {
        "type": "field_changed",
        "fieldKey": "requirements"
      },
      "conditions": [],
      "actions": [
        {
          "type": "sync_requirement_checks",
          "sheetRef": "check",
          "notifyFieldKey": "owner"
        }
      ]
    },
    {
      "ref": "sync_button",
      "sheet": "supplier",
      "name": "Sync requirements button → sync the requirement checks",
      "trigger": {
        "type": "button_clicked",
        "fieldKey": "sync_requirements"
      },
      "conditions": [],
      "actions": [
        {
          "type": "sync_requirement_checks",
          "sheetRef": "check",
          "notifyFieldKey": "owner"
        }
      ]
    },
    {
      "ref": "resync_on_new_requirement",
      "sheet": "requirement",
      "name": "Requirement added → add its checks to the suppliers it applies to",
      "trigger": {
        "type": "item_created"
      },
      "conditions": [],
