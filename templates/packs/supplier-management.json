    {
      "ref": "requirement",
      "name": "Supplier requirements",
      "description": "The master list of what suppliers are held to, with the rules for which suppliers each applies to. The sync adds a check per supplier and requirement.",
      "itemLabel": "Requirement",
      "idPrefix": "SRQ-",
      "folder": "suppliers",
      "isLibrary": true,
      "groups": [
        {
          "ref": "all",
