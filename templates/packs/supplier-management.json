{
  "key": "supplier-management",
  "version": "1.1.0",
  "title": "Supplier management",
  "description": "A supplier register with reviews, a library of supplier requirements with the rules for who they apply to, a check per supplier and requirement kept in step for you, and the supplier documents you control. Comes with automations, a self-assessment form and a dashboard.",
  "requires": [],
  "folders": [
    {
      "ref": "suppliers",
      "name": "Suppliers"
    }
  ],
  "sheets": [
    {
      "ref": "supplier",
      "name": "Supplier register",
      "description": "Suppliers you depend on, how critical they are and when they are next reviewed.",
      "itemLabel": "Supplier",
      "idPrefix": "SUP-",
      "folder": "suppliers",
      "groups": [
        {
          "ref": "active",
          "name": "Active",
          "color": "green"
        },
        {
          "ref": "onboarding",
          "name": "Onboarding",
          "color": "blue"
        },
        {
          "ref": "exited",
          "name": "Exited",
          "color": "grey"
        }
      ],
      "fields": [
        {
          "key": "owner",
          "name": "Owner",
          "type": "people",
          "config": {
            "multiple": false
          }
        },
        {
          "key": "status",
          "name": "Status",
          "type": "status",
          "config": {
            "options": [
              {
                "id": "opt_approved",
                "label": "Approved",
                "color": "green",
                "done": true
              },
              {
                "id": "opt_review",
                "label": "Under review",
                "color": "orange"
              },
              {
                "id": "opt_blocked",
                "label": "Blocked",
                "color": "red"
              }
            ]
          }
        },
        {
          "key": "category",
          "name": "Category",
          "type": "dropdown",
          "config": {
            "options": [
              {
                "id": "opt_it",
                "label": "IT and cloud",
                "color": "blue"
              },
              {
                "id": "opt_parts",
                "label": "Parts and materials",
                "color": "teal"
              },
              {
                "id": "opt_services",
                "label": "Services",
                "color": "purple"
              }
            ]
          }
        },
        {
          "key": "criticality",
          "name": "Criticality",
          "type": "severity"
        },
        {
          "key": "next_review",
          "name": "Next review",
          "type": "date"
        },
        {
          "key": "processes_personal_data",
          "name": "Processes personal data",
          "type": "check",
          "description": "Ticked when the supplier processes personal data for you: the Art. 28 requirements apply."
        },
        {
          "key": "reviews",
          "name": "Reviews",
          "type": "link",
          "config": {
            "targetSheetRef": "review",
            "multiple": true,
            "inverseKey": "supplier"
          }
        },
        {
          "key": "requirements",
          "name": "Extra requirements",
          "type": "requirement",
          "config": {
            "targetSheetRef": "requirement",
            "multiple": true
          },
          "description": "Requirements from the library that apply to this supplier beyond the rules. Each gets a check with the source Added manually."
        },
        {
          "key": "checks",
          "name": "Requirement checks",
          "type": "link",
          "description": "One check per requirement that applies, added and flagged by the sync.",
          "config": {
            "targetSheetRef": "check",
            "multiple": true,
            "inverseKey": "supplier",
            "panel": "checklist",
            "panelFields": [
              "evidence",
              "evidence_expiry"
            ],
            "panelEmpty": "Choose a category and criticality and we will add the requirements for this supplier."
          }
        },
        {
          "key": "requirements_met",
          "name": "Requirements met",
          "type": "rollup",
          "config": {
            "linkFieldKey": "checks",
            "targetFieldKey": "status",
            "fn": "doneOf",
            "ignore": [
              "opt_na",
              "opt_no_longer"
            ]
          }
        },
        {
          "key": "pct_met",
          "name": "% met",
          "type": "rollup",
          "config": {
            "linkFieldKey": "checks",
            "targetFieldKey": "status",
            "fn": "pctDone",
            "ignore": [
              "opt_na",
              "opt_no_longer"
            ]
          }
        },
        {
          "key": "worst_check",
          "name": "Worst check",
          "type": "rollup",
          "config": {
            "linkFieldKey": "checks",
            "targetFieldKey": "status",
            "fn": "worst",
            "ignore": [
              "opt_na",
              "opt_no_longer"
            ]
          }
        },
        {
          "key": "expired_evidence",
          "name": "Expired evidence",
          "type": "rollup",
          "config": {
            "linkFieldKey": "checks",
            "targetFieldKey": "evidence_expiry",
            "fn": "countExpired",
            "ignore": [
              "opt_na",
              "opt_no_longer"
            ]
          }
        },
        {
          "key": "sync_requirements",
          "name": "Sync requirements",
          "type": "button",
          "config": {
            "label": "Sync requirements"
          }
        },
        {
          "key": "documents",
          "name": "Documents",
          "type": "link",
          "config": {
            "targetSheetRef": "document",
            "multiple": true
          }
        },
        {
          "key": "notes",
          "name": "Notes",
          "type": "longtext"
        }
      ],
      "views": [
        {
          "name": "By status",
          "type": "kanban",
          "config": {
            "labelFieldKey": "status"
          }
        },
        {
          "name": "Requirements",
          "type": "table",
          "config": {
            "sort": [
              {
                "fieldKey": "pct_met",
                "direction": "asc"
              }
            ]
          }
        }
      ],
      "tabs": [
        {
          "ref": "table"
        },
        {
          "ref": "By status"
        },
        {
          "ref": "calendar"
        }
      ],
      "forms": [
        {
          "ref": "self_assessment",
          "name": "Supplier self-assessment",
          "groupRef": "onboarding",
          "access": "public",
          "layout": {
            "title": "Supplier self-assessment",
            "description": "Tell us about your organisation and how you meet our requirements.",
            "nameLabel": "Organisation name",
            "fields": [
              {
                "key": "category",
                "label": "What do you supply?"
              },
              {
                "key": "notes",
                "label": "How do you meet our requirements?",
                "required": true
              }
            ]
          },
          "notice": {
            "purpose": "To assess suppliers before and during our work with them.",
            "legalBasis": "legitimate_interests",
            "recipients": "The people in this workspace who manage suppliers.",
            "retention": "Kept while you are a supplier and for 3 years after.",
            "rights": "You can ask to see, correct or delete your answers. Contact the person who shared this form."
          }
        }
      ],
      "items": [
        {
          "ref": "cloudhost",
          "group": "active",
          "name": "Northwind Cloud Hosting",
          "values": {
            "status": "opt_approved",
            "category": "opt_it",
            "criticality": "$option:High",
            "next_review": "$in:45",
            "processes_personal_data": true
