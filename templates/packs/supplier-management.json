      "ref": "resync_on_criticality",
      "sheet": "requirement",
      "name": "Applies from criticality changed → re-sync the suppliers",
      "trigger": {
        "type": "field_changed",
        "fieldKey": "min_criticality"
      },
      "conditions": [],
      "actions": [
        {
          "type": "sync_requirement_checks",
          "sheetRef": "check"
        }
      ]
    },
    {
      "ref": "requirement_reworded",
      "sheet": "requirement",
      "name": "Guidance changed → raise the version",
      "trigger": {
        "type": "field_changed",
        "fieldKey": "guidance"
      },
      "conditions": [],
      "actions": [
        {
          "type": "raise_version",
          "fieldKey": "version",
          "kind": "minor"
        }
      ]
    },
    {
      "ref": "check_answered",
      "sheet": "check",
      "name": "Check answered → record who, when and the wording it was checked against",
      "trigger": {
        "type": "field_changed",
        "fieldKey": "status"
      },
      "conditions": [
        {
          "fieldKey": "status",
          "op": "is_none_of",
          "value": [
            "opt_not_checked",
            "opt_no_longer"
          ]
        }
      ],
      "actions": [
        {
          "type": "set_field",
          "fieldKey": "wording_at_check",
          "template": true,
          "value": "{requirement} {name}: {requirement_guidance}"
        },
        {
          "type": "set_field",
          "fieldKey": "version_at_check",
          "template": true,
          "value": "{requirement_version}"
        },
        {
          "type": "set_field",
          "fieldKey": "checked_on",
          "value": "$today"
        },
        {
          "type": "set_field",
          "fieldKey": "checked_by",
          "value": "$actor"
        }
      ]
    },
    {
      "ref": "check_not_met",
      "sheet": "check",
      "name": "Check not met → tell the supplier owner",
      "trigger": {
        "type": "field_becomes",
        "fieldKey": "status",
        "value": "opt_not_met"
      },
      "conditions": [],
      "actions": [
        {
          "type": "notify",
          "to": [
            "field:supplier_owner"
          ],
          "message": "{supplier} does not meet \"{name}\" ({id}). Decide what happens next."
        }
      ]
    },
    {
      "ref": "evidence_expiring",
      "sheet": "check",
      "name": "Evidence expires in 30 days → tell the supplier owner",
      "trigger": {
        "type": "date_arrives",
        "fieldKey": "evidence_expiry",
        "offsetDays": -30
      },
      "conditions": [
        {
          "fieldKey": "status",
          "op": "is_any_of",
          "value": [
            "opt_met"
          ]
        }
      ],
      "actions": [
        {
          "type": "notify",
          "to": [
            "field:supplier_owner"
          ],
          "message": "Evidence for \"{name}\" ({id}) at {supplier} expires on {evidence_expiry}. Ask for new evidence."
        }
      ]
    }
