  "automations": [
    {
      "ref": "review_due",
      "sheet": "supplier",
      "name": "Review due in 14 days → ask the owner for an update",
      "trigger": {
        "type": "date_arrives",
        "fieldKey": "next_review",
        "offsetDays": -14
      },
      "conditions": [],
      "actions": [
        {
          "type": "request_update",
          "fieldKey": "owner",
          "message": "{id} {name} is due for review on {next_review}. Please plan it."
        }
      ]
    },
    {
      "ref": "review_failed",
      "sheet": "review",
      "name": "Review failed → tell the supplier owner",
      "trigger": {
        "type": "field_becomes",
        "fieldKey": "result",
        "value": "opt_fail"
      },
      "conditions": [],
      "actions": [
        {
          "type": "notify",
          "to": [
            "field:supplier_owner"
          ],
          "message": "{name} of {supplier} failed. Decide what happens next."
        }
      ]
    },
    {
      "ref": "sync_on_create",
      "sheet": "supplier",
      "name": "Supplier added → sync its requirement checks",
      "trigger": {
        "type": "item_created"
      },
      "conditions": [],
      "actions": [
        {
          "type": "sync_requirement_checks",
          "sheetRef": "check",
          "notifyFieldKey": "owner"
        }
      ]
    },
    {
      "ref": "sync_on_category",
