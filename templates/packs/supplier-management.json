          "type": "longtext"
        },
        {
          "key": "applies_when",
          "name": "Applies to",
          "type": "dropdown",
          "description": "Every supplier, by category and criticality, suppliers that process personal data (the Art. 28 set) or only when added by hand.",
          "config": {
            "options": [
              {
                "id": "opt_all",
                "label": "Every supplier",
                "color": "green"
              },
              {
                "id": "opt_rules",
                "label": "By category and criticality",
                "color": "blue"
              },
              {
                "id": "opt_processors",
                "label": "Suppliers that process personal data (Art. 28)",
                "color": "purple"
              },
              {
                "id": "opt_manual_only",
                "label": "Only when added by hand",
                "color": "grey"
              }
            ]
          }
        },
        {
          "key": "applies_categories",
          "name": "Applies to categories",
          "type": "multiselect",
          "description": "Empty: every category. Matched to the supplier’s category by option or by name.",
          "config": {
            "options": [
              {
                "id": "opt_it",
                "label": "IT and cloud",
                "color": "blue"
              },
              {
                "id": "opt_parts",
                "label": "Parts and materials",
                "color": "teal"
              },
              {
                "id": "opt_services",
                "label": "Services",
                "color": "purple"
              }
