              "code_of_conduct"
            ]
          }
        },
        {
          "ref": "fasteners",
          "group": "onboarding",
          "name": "Leeds Fasteners Ltd",
          "values": {
            "status": "opt_review",
            "category": "opt_parts",
            "criticality": "$option:Medium",
            "next_review": "$in:10"
          },
          "links": {
            "requirements": [
              "quality_certificate"
            ]
          }
        }
      ]
    },
    {
