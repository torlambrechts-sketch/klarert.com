{
  "recipes": [
    { "id": "status-notify", "title": "When status changes to something, notify someone",
      "roles": { "status": ["status"], "person": ["people"] },
      "trigger": { "type": "field_becomes", "fieldKey": "{status}", "value": null },
      "actions": [ { "type": "notify", "to": ["field:{person}"], "message": "{id} {name} is now {{status}}." } ] },
    { "id": "due-request", "title": "When a date arrives, ask the owner for an update",
      "roles": { "date": ["date", "datetime", "timeline", "recurrence"], "person": ["people"], "status": ["status"] },
      "trigger": { "type": "date_arrives", "fieldKey": "{date}", "offsetDays": -3 },
      "conditions": [ { "fieldKey": "{status}", "op": "is_not_done" } ],
      "actions": [ { "type": "request_update", "fieldKey": "{person}", "message": "{name} is due on {{date}}. Please update it." } ] },
    { "id": "overdue-stuck", "title": "When a date passes and the item is not done, set status to Stuck",
      "roles": { "date": ["date"], "status": ["status"] },
      "trigger": { "type": "date_arrives", "fieldKey": "{date}", "offsetDays": 1 },
      "conditions": [ { "fieldKey": "{status}", "op": "is_not_done" } ],
      "actions": [ { "type": "set_field", "fieldKey": "{status}", "value": null } ] },
    { "id": "done-lock", "title": "When status is done, lock the item",
      "roles": { "status": ["status"] },
      "trigger": { "type": "field_becomes", "fieldKey": "{status}", "value": null },
      "actions": [ { "type": "lock_item", "reason": "Completed" } ] },
    { "id": "button-create", "title": "When a button is clicked, create a linked item on another sheet",
      "roles": { "button": ["button"] },
      "trigger": { "type": "button_clicked", "fieldKey": "{button}" },
      "actions": [ { "type": "create_item", "sheetId": null, "name": "Follow-up: {name}", "values": {}, "link": true } ] },
    { "id": "score-high", "title": "When a score goes above a number, notify someone",
      "roles": { "number": ["number", "formula", "rollup", "riskmatrix", "percent"], "person": ["people"] },
      "trigger": { "type": "number_above", "fieldKey": "{number}", "threshold": 12 },
      "actions": [ { "type": "notify", "to": ["field:{person}"], "message": "{name}: {{number}} is above 12." } ] },
    { "id": "evidence-expiring", "title": "When evidence is about to expire, request a new file",
      "roles": { "evidence": ["evidence"], "person": ["people"] },
      "trigger": { "type": "evidence_expiring", "fieldKey": "{evidence}", "days": 30 },
      "actions": [ { "type": "request_update", "fieldKey": "{person}", "message": "Evidence on {name} expires soon. Please upload a current file." } ] },
    { "id": "checklist-no", "title": "When a checklist answer is No, create an action",
      "roles": { "checklist": ["checklist"] },
      "trigger": { "type": "checklist_no", "fieldKey": "{checklist}" },
      "actions": [ { "type": "create_item", "sheetId": null, "name": "Fix: {name}", "values": {}, "link": true } ] },
    { "id": "linked-update", "title": "When status changes, update the items this item links to",
      "roles": { "status": ["status"], "link": ["link"] },
      "trigger": { "type": "field_becomes", "fieldKey": "{status}", "value": null },
      "actions": [ { "type": "update_linked", "path": { "direction": "out", "linkFieldKey": "{link}" }, "fieldKey": null, "value": null } ] },
    { "id": "form-alert", "title": "When a form is submitted, notify the team",
      "roles": { "severity": ["severity"] },
      "trigger": { "type": "form_submitted", "formId": null },
      "actions": [ { "type": "notify", "to": [], "message": "New {sheet} report: {name} ({{severity}})." } ] }
  ],
  "notes": "Placeholders: {role} in fieldKey positions is replaced by the field key the person picks for that role; {{role}} inside messages becomes {<field_key>}. null values must be filled in the builder before saving."
}
