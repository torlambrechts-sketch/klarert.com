# Supabase (EU project, Frankfurt). Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: scheduler, webhook worker, public form route, automation effects
SUPABASE_COMMAND_SECRET=            # server only: signs writes (migration 0053), same value as the Vault secret klarert_command_secret; optional locally
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                        # Vercel Cron sends it as a Bearer token
# Public forms: signs the "page served at" stamp and keys the per-visitor rate limit. Server only, at least 32
# characters (openssl rand -hex 32). Without it public forms refuse every answer (fail closed).
FORM_RATE_LIMIT_SALT=
# Email (docs/09 §10), server only. Brevo transactional API (data kept in the EU), sending domain mail.klarert.com.
# Without a key no email is sent (invites still work by copying the link), except next to a local Supabase, where mail
# goes to Mailpit (http://127.0.0.1:54324). CI never uses the key.
BREVO_API_KEY=
EMAIL_FROM="Compliance OS <no-reply@mail.klarert.com>"
# Tests only (ignored in production builds)
TEST_TODAY=2026-11-11
