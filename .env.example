# Supabase (EU project, Frankfurt). Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: scheduler, webhook worker, public form route, automation effects
SUPABASE_COMMAND_SECRET=            # server only: signs writes (migration 0053), same value as the Vault secret klarert_command_secret; optional locally
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                        # Vercel Cron sends it as a Bearer token
# Tests only (ignored in production builds)
TEST_TODAY=2026-11-11
